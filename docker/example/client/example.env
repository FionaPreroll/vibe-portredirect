# Copy to .env and fill in.

# The server's address, e.g. its DNS name.
PORTREDIRECT_QUIC_REMOTE_HOST=tunnel.example.com
# The fingerprint of the server's certificate, which the server logs when it starts:
# docker compose logs | grep fingerprint
PORTREDIRECT_QUIC_CERT_FINGERPRINT=
# The same PSK as the server's.
PORTREDIRECT_PSK=
