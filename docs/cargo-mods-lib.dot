    "portredirect::forward" [label="pub(crate) mod|forward", fillcolor="#f8c04c"]; // "mod" node
    "portredirect::limits" [label="pub(crate) mod|limits", fillcolor="#f8c04c"]; // "mod" node
    "portredirect::metrics" [label="pub(crate) mod|metrics", fillcolor="#f8c04c"]; // "mod" node
    "portredirect::private_files" [label="pub(crate) mod|private_files", fillcolor="#f8c04c"]; // "mod" node
    "portredirect::protocol" [label="pub(crate) mod|protocol", fillcolor="#f8c04c"]; // "mod" node
