    "portredirect::client::reconnect" [label="pub(crate) mod|client::reconnect", fillcolor="#f8c04c"]; // "mod" node
    "portredirect::client::run_client" [label="pub(crate) mod|client::run_client", fillcolor="#f8c04c"]; // "mod" node
