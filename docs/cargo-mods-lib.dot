digraph {

    graph [
        label="portredirect",
        labelloc=t,

        pad=0.4,

        // Consider rendering the graph using a different layout algorithm, such as:
        // [dot, neato, twopi, circo, fdp, sfdp]
        layout=neato,
        overlap=false,
        splines="line",
        rankdir=LR,

        fontname="Helvetica", 
        fontsize="36",
    ];

    node [
        fontname="monospace",
        fontsize="10",
        shape="record",
        style="filled",
    ];

    edge [
        fontname="monospace",
        fontsize="10",
    ];

    "portredirect" [label="crate|portredirect", fillcolor="#5397c8"]; // "crate" node
    "portredirect::app_data" [label="pub(crate) mod|app_data", fillcolor="#f8c04c"]; // "mod" node
    "portredirect::bi_stream" [label="pub(crate) mod|bi_stream", fillcolor="#f8c04c"]; // "mod" node
