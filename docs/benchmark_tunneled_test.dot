digraph tunneled_test {
  // Global graph settings
  graph [bgcolor=white, rankdir=TB, splines=true];
  node  [fontname="Helvetica,Arial,sans-serif", shape=box, style="rounded,filled", fillcolor="#ecf0f1", color="#2c3e50", fontcolor="#2c3e50", fontsize=10, margin="0.2,0.1"];
  edge  [fontname="Helvetica,Arial,sans-serif", color="#16a085", fontsize=9];

  // Nodes with HTML labels for formatting
  web_browser [label=<
    <B>User</B><BR/>
    <I>(Web Browser)</I>
  >];
  
  portredirect_server [label=<
    <b>Very Small Server with Public IP</b><br/>
    <i>portredirect_server</i><br/>
    Listening on:<br/>
    TCP Port 443<br/>
    QUIC Port 12345
  >];
  
  portredirect_client [label=<
    <B>Home Server</B><BR/>
    <i>portredirect_client</i>
  >];
  
  web_server [label=<
    <B>Home Server</B><BR/>
    <I>HTTPS Web Server (e.g. nginx)</I><BR/>
    Listening on:<BR/>
    TCP 127.0.0.1:443
  >];

  // Edges
  web_browser -> portredirect_server [label="TCP"];
  portredirect_client -> portredirect_server [label="QUIC connection/tunnel", color="#e74c3c"];
  portredirect_client -> web_server [label="TCP"];
}
